{
  "root": true,
  "env": {
    "browser": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 5,
    "sourceType": "script"
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": "warn",
    "eqeqeq": "error"
  },
  "overrides": [
    {
      "files": ["tests/e2e/**/*.js", "playwright.config.js"],
      "parserOptions": { "ecmaVersion": 2020 }
    }
  ]
}
